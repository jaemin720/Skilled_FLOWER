{
  "robot": {
    "is_sim": false,
    "backend": "plaif",
    "plaif": {
      "platform": "monkey",
      "task": "sku",
      "wait_for_data": true,
      "state_timeout": 10.0,
      "velocity_filter_alpha": 0.25,
      "follow_period": 0.1
    },
    "gripper": {
      "right": {
        "type": "dhgripper",
        "port": "/dev/dh_gripper_right"
      }
    }
  },
  "train": {
    "arm_type": "right",
    "hz": 10,
    "action_chunk_mode": "delta",
    "server_action_frame": "tcp",
    "server_rotation_unit": "rad",
    "proprio_keys": [
      "right/gripper_pose",
      "right/tcp_force",
      "right/tcp_pose",
      "right/tcp_torque",
      "right/tcp_vel"
    ],
    "wrappers": {
      "serlobs": {
        "obs_horizon": 1
      },
      "keyboard": {
        "enable": true,
        "save_episodes": true,
        "keys": {
          "success": "ctrl_r",
          "failure": "f9",
          "skip": "f10",
          "save_and_quit": "f12",
          "toggle_rotation_lock": "caps_lock"
        }
      }
    },
    "policy_arm": "right"
  },

  "env": {
    "right": {
      "robot_prefix": "right",
      "reset_pose":  [0.295, -0.264, 0.161, -3.141592, 0.0, 3.141592] ,
      "reset_pose_max":  [0.32, -0.224, 0.163, -3.141592, 0.0, 3.141592] ,
      "xyz_clip_low": [0.15, -0.8, 0.0, -1.6, -1.6, -1.6],
      "xyz_clip_high": [0.65, 0.2, 0.286, 1.6, 1.6, 1.6],
      "spacemouse_action_scale": [0.05, 0.05, 0.05, 0.00, 0.00, 0.1],
      "spacemouse_symlog_temperature": 20.0,
      "max_episode_length": 15000,
      "display_image": false,
      "gripper_control": {
        "mode": "binary",
        "teleop_backend": "toggle"
      }
    }
  },
  "cameras": {
    "wrist_cam_d405_a": {
      "type": "realsense",
      "params": {
        "serial_number": "260322274715",
        "dim": [640, 480],
        "fps": 30,
        "exposure":7000
      }
    },
    "head_cam_d455": {
      "type": "realsense",
      "params": {
        "serial_number": "213522254901",
        "dim": [640, 480],
        "fps": 30,
        "exposure": 18
      }
    }
  }
}
